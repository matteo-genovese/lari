# Runtime settings use the LARI_* prefix; the UI brand is independent.
# Generate a unique URL token and keep this file private (it is Git-ignored).
LARI_TOKEN=
LARI_PORT=8643
# Optional desktop-only client: use an existing bridge instead of this PC's server.
# Complete private HTTPS satellite URL, including its token. Keep it secret.
# LARI_DESKTOP_URL=https://your-private-host:8443/your-token/
# Optional desktop identity on local or remote bridges (default: empty).
# Use [a-z0-9][a-z0-9-]{0,31}; invalid names are ignored with a warning.
# Overrides device in LARI_DESKTOP_URL and is passed to the page and WebSocket.
LARI_DEVICE=
# Native mascot wanders along the screen edge; dragging remains available.
LARI_DESKTOP_ROAM=1
# Optional named desktop commands: JSON object mapping names to argv arrays.
# LARI_DESKTOP_COMMANDS=/home/you/.config/lari/commands.json

# Hermes API (the assistant brain); configure its API key if authentication is enabled.
LARI_HERMES_API=http://127.0.0.1:8642
LARI_HERMES_KEY=
# Resume the transcript per device (including default); first turn sends no id
# until Hermes returns one. Set to 0 to disable all session-id reuse/storage.
LARI_SESSION_RESUME=1
# Only session ids and hashed session-key indices; created owner-only (0600).
# Default: $XDG_STATE_HOME/lari/sessions.json or ~/.local/state/lari/sessions.json
# LARI_SESSION_STATE=/absolute/path/to/sessions.json
# Leave empty to follow the model/provider configured in the Hermes profile.
LARI_HERMES_PROVIDER=
LARI_HERMES_MODEL=
# HTTP timeout and maximum wait without text, tool/status or approval events.
LARI_AGENT_TIMEOUT=180
# SSE keepalive comments do not reset this limit (seconds).
LARI_AGENT_STALL_S=120.0
# Optional: defaults to ~/.hermes/hermes-agent
# LARI_HERMES_ROOT=/absolute/path/to/hermes-agent

# Wake phrase: one setting; command regex, Vosk grammar, junk cleanup and
# provider keyterms derive from it. Defaults to "ehi lari" (or "hey lari" with
# a non-Italian LARI_STT_LANG). After real-voice calibration, list the ASR
# variants you observed:
# LARI_WAKE_ALIASES=ehi lare,hey lare
# Observed spurious words at the start of transcripts, per installation;
# cleanup only, does not create wake triggers (comma-separated).
# LARI_WAKE_OBSERVED_JUNK=
LARI_WAKE_PROVIDER=whisper
LARI_WAKE_PHRASE=ehi lari
LARI_STT_BACKEND=whisper
# Code default: base; this example deliberately uses small for better quality.
LARI_STT_MODEL=small
LARI_STT_LANG=it
# Extra vocabulary biased in cloud STT (names and places the ASR misrenders):
# LARI_STT_KEYTERMS=Roma Termini
# Second local wake gate before the paid provider opens (default on):
# LARI_WAKE_CONFIRM=0
# Uncomment only if your downloaded Vosk model is elsewhere:
# LARI_VOSK_MODEL_DIR=/absolute/path/to/vosk-model-small-it-0.22

# Optional: set LARI_STT_BACKEND=elevenlabs_realtime and add an ElevenLabs key.
# Realtime has provider charges. Its local seconds cap is NOT a spending cap.
# ELEVENLABS_API_KEY=
# LARI_REALTIME_DAILY_SECONDS=600

# Optional batch cloud STT (paid per utterance): LARI_STT_BACKEND=elevenlabs|groq|openai,
# with the matching key. Local backends (whisper, vosk) need no key.
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Report usage mensile (file ledger + /<token>/usage). La stima costo resta
# None finché non imposti tu il tuo tasso reale dal pannello del provider.
#LARI_USAGE_LEDGER=usage.json
#LARI_USAGE_EUR_PER_MIN=
