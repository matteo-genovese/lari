# Runtime settings use the LARI_* prefix; the UI brand is independent.
# Generate a unique URL token and keep this file private (it is Git-ignored).
LARI_TOKEN=
LARI_PORT=8643

# Hermes API (the assistant brain); configure its API key if authentication is enabled.
LARI_HERMES_API=http://127.0.0.1:8642
LARI_HERMES_KEY=
LARI_HERMES_PROVIDER=deepseek
LARI_HERMES_MODEL=deepseek-flash
# Optional: defaults to ~/.hermes/hermes-agent
# LARI_HERMES_ROOT=/absolute/path/to/hermes-agent

# Wake phrase: one setting; command regex, Vosk grammar, junk cleanup and
# provider keyterms derive from it. Defaults to "ehi lari" (or "hey lari" with
# a non-Italian LARI_STT_LANG). After real-voice calibration, list the ASR
# variants you observed:
# LARI_WAKE_ALIASES=ehi lare,hey lare
LARI_WAKE_PROVIDER=whisper
LARI_WAKE_PHRASE=ehi lari
LARI_STT_BACKEND=whisper
LARI_STT_MODEL=small
LARI_STT_LANG=it
# Extra vocabulary biased in cloud STT (names and places the ASR misrenders):
# LARI_STT_KEYTERMS=Roma Termini
# Second local wake gate before the paid provider opens (default on):
# LARI_WAKE_CONFIRM=0
# Uncomment only if your downloaded Vosk model is elsewhere:
# LARI_VOSK_MODEL_DIR=/absolute/path/to/vosk-model-small-it-0.22

# Optional: set LARI_STT_BACKEND=elevenlabs_realtime and add an ElevenLabs key.
# Realtime has provider charges. Its local seconds cap is NOT a spending cap.
# ELEVENLABS_API_KEY=
# LARI_REALTIME_DAILY_SECONDS=600

# Report usage mensile (file ledger + /<token>/usage). La stima costo resta
# None finché non imposti tu il tuo tasso reale dal pannello del provider.
#LARI_USAGE_LEDGER=usage.json
#LARI_USAGE_EUR_PER_MIN=
