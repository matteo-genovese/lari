# Required: generate a random value and keep it private.
LARI_TOKEN=

# Interface, recognition, voice and default wake phrase.
LARI_LANGUAGE=it
# Leave empty to use the language default (Ehi Lari / Hey Lari).
LARI_WAKE_PHRASE=
# Optional comma-separated pronunciation/ASR variants. Keep these installation-specific.
LARI_WAKE_ALIASES=
LARI_TTS_VOICE=

# Bridge and Hermes API.
LARI_PORT=8643
LARI_HERMES_API=http://127.0.0.1:8642
LARI_HERMES_ROOT=
LARI_HERMES_KEY=
LARI_SESSION_KEY=lari
LARI_AGENT_BACKEND=hermes
# Leave provider/model overrides empty to use the built-in defaults.
LARI_HERMES_PROVIDER=
LARI_HERMES_MODEL=
LARI_DEEPSEEK_MODEL=deepseek-flash
LARI_AGENT_TIMEOUT=180
LARI_CLI_TIMEOUT=70

# Wake and local speech recognition.
LARI_WAKE_PROVIDER=whisper
LARI_SENSITIVITY=0.5
LARI_CONFIRM_FRAMES=3
LARI_COOLDOWN_S=2
LARI_STT_BACKEND=whisper
LARI_STT_MODEL=base
LARI_STT_LANG=
LARI_VOSK_MODEL_DIR=
LARI_STT_GATE=
LARI_VAD_MIN_RMS=900
LARI_VAD_NOISE_MULT=2.5
LARI_AMBIENT_PAUSE=6
LARI_SILENCE_END=2.5
LARI_MAX_UTTERANCE_S=45
LARI_MIN_SPEECH_S=0.7
LARI_IDLE_ABORT_S=4

# Playback, follow-up and response streaming.
LARI_ECHO_MUTE=2.5
LARI_FOLLOWUP_S=30
LARI_PLAYBACK_ACK_TIMEOUT=45
LARI_STREAM_TTS_QUEUE_MAX=8
LARI_STREAM_TEXT_MAX_CHARS=4000
LARI_STREAM_SENTENCE_MAX_CHARS=280

# Optional local Realtime usage cap. Realtime is not an account-wide billing cap.
LARI_REALTIME_DAILY_SECONDS=600
LARI_REALTIME_USAGE_FILE=.realtime_stt_usage.json

# Optional provider credentials. Keep real values in your private environment only.
ELEVENLABS_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
