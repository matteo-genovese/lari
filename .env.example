# The runtime keeps the legacy BUDDY_* names; the UI brand is independent.
# Generate a unique URL token and keep this file private (it is Git-ignored).
BUDDY_TOKEN=
BUDDY_PORT=8643

# Hermes API (the assistant brain); configure its API key if authentication is enabled.
BUDDY_HERMES_API=http://127.0.0.1:8642
BUDDY_HERMES_KEY=
BUDDY_AGENT_BACKEND=hermes
BUDDY_HERMES_PROVIDER=deepseek
BUDDY_HERMES_MODEL=deepseek-flash
# Optional: defaults to ~/.hermes/hermes-agent
# BUDDY_HERMES_ROOT=/absolute/path/to/hermes-agent

# Wake phrase: one setting; command regex, Vosk grammar, junk cleanup and
# provider keyterms derive from it. Defaults to "ehi lari" (or "hey lari" with
# a non-Italian BUDDY_STT_LANG). After real-voice calibration, list the ASR
# variants you observed:
# BUDDY_WAKE_ALIASES=ehi lare,hey lare
BUDDY_WAKE_PROVIDER=whisper
BUDDY_WAKE_PHRASE=ehi lari
BUDDY_STT_BACKEND=whisper
BUDDY_STT_MODEL=small
BUDDY_STT_LANG=it
# Extra vocabulary biased in cloud STT (names and places the ASR misrenders):
# BUDDY_STT_KEYTERMS=Roma Termini
# Uncomment only if your downloaded Vosk model is elsewhere:
# BUDDY_VOSK_MODEL_DIR=/absolute/path/to/vosk-model-small-it-0.22

# Optional: set BUDDY_STT_BACKEND=elevenlabs_realtime and add an ElevenLabs key.
# Realtime has provider charges. Its local seconds cap is NOT a spending cap.
# ELEVENLABS_API_KEY=
# BUDDY_REALTIME_DAILY_SECONDS=600
